# Required browser-safe Supabase configuration.
# Copy this file to .env.local and fill in values from the target Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: required only when server-side AI BYOK provider keys are enabled.
# Must be a 64-character hexadecimal secret (32 bytes). Never prefix with NEXT_PUBLIC_.
AI_SETTINGS_ENCRYPTION_KEY=